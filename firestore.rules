rules_version = '2';

// DJ ClientFlow — every account can read and write ONLY its own data.
// Deployed with `firebase deploy --only firestore:rules` (the GitHub
// workflow does this on every push), or paste them into Firebase
// Console → Firestore Database → Rules and click Publish.
// Without them your database is either wide open or fully closed.
service cloud.firestore {
  match /databases/{database}/documents {

    // --- helpers -----------------------------------------------------

    function ownsExisting() {
      return request.auth != null
             && resource.data.ownerUid == request.auth.uid;
    }

    function ownsIncoming() {
      return request.auth != null
             && request.resource.data.ownerUid == request.auth.uid;
    }

    // The client's one-time signing write on a contract: the contract
    // must still be open, and the write may only add the signature.
    // The signing time is stamped by Firestore itself (request.time),
    // so a signer can't backdate or postdate it from their own device.
    function isClientSigning() {
      let sig = request.resource.data.clientSignature;
      return resource.data.get('revoked', false) != true
             && resource.data.get('voided', false) != true
             && resource.data.get('clientSigned', false) != true
             && request.resource.data.clientSigned == true
             && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['clientSigned', 'clientSignature', 'updatedAtMs'])
             && sig is map
             && sig.keys().hasOnly(['kind', 'name', 'email', 'dataUrl', 'signedAt', 'signedAtServer'])
             && sig.kind in ['typed', 'drawn']
             && sig.name is string
             && sig.name.size() > 0
             && sig.name.size() <= 120
             && sig.get('email', '') is string
             && sig.get('email', '').size() <= 254
             && sig.get('dataUrl', '') is string
             && sig.get('dataUrl', '').size() <= 80000
             && sig.get('signedAt', '') is string
             && sig.get('signedAt', '').size() <= 40
             && sig.signedAtServer == request.time
             && request.resource.data.get('updatedAtMs', 0) is int;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // The account document's old whole-account lists (schema 2).
    function legacyLists() {
      return ['clients', 'events', 'invoices', 'contracts'].toSet();
    }

    // Once an account has moved to one document per record (schema 3),
    // the old format is closed: an out-of-date copy of the app can't
    // write the whole account back into this document. The old lists
    // may only be left alone or removed, and the schema can't go back.
    function accountDocWriteOk() {
      return resource == null
             || resource.data.get('schema', 0) != 3
             || (request.resource.data.get('schema', 0) == 3
                 && request.resource.data.keys().toSet()
                      .intersection(request.resource.data.diff(resource.data).affectedKeys())
                      .intersection(legacyLists()).size() == 0);
    }

    // --- the account's own data --------------------------------------

    match /djclientflow/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && accountDocWriteOk();

      // One document per client, gig, invoice and contract; uploaded
      // invoice PDFs; and the copy kept when an account is moved to
      // the per-record format. All of it belongs to the account alone.
      match /{section}/{docId} {
        allow read, write: if isOwner(userId)
                           && section in ['clients', 'events', 'invoices', 'contracts', 'files', 'backups'];
      }
    }

    // --- quotes and invoices shared on a live link --------------------
    // The link holds a long random id and that id is the only way in: a
    // client can fetch the one document they were sent, and nothing can
    // list the collection to go looking for others. Only the DJ who owns
    // a shared document can create, change or switch it off.

    match /shared/{shareId} {
      allow get: if true;
      allow list: if false;
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
      allow delete: if ownsExisting();
    }

    // --- contracts sent out for signature -----------------------------
    // Read works the same way. On top of that there is exactly one write
    // an unsigned-in visitor may make: adding their signature, once, to
    // a contract that is still live and unsigned. Nothing else about the
    // document can be touched without being the owner.

    match /contracts/{contractId} {
      allow get: if true;
      allow list: if false;
      allow create: if ownsIncoming();
      allow delete: if ownsExisting();
      allow update: if (ownsExisting() && ownsIncoming()) || isClientSigning();
    }

    // Anything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
