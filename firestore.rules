rules_version = '2';

// DJ ClientFlow — every account can read and write ONLY its own document.
// Publish these in Firebase Console → Firestore Database → Rules.
// Without them your database is either wide open or fully closed.
service cloud.firestore {
  match /databases/{database}/documents {

    match /djclientflow/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      // Uploaded invoice PDFs belong to the same account.
      match /files/{fileId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }
    }

    // Quotes and invoices shared with a client on a live link. The link
    // holds a long random id and that id is the only way in: a client
    // can fetch the one document they were sent, and nothing can list
    // the collection to go looking for others. Only the DJ who owns a
    // shared document can create, change or switch it off.
    match /shared/{shareId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid;
    }

    // Anything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
